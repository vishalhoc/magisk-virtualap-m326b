#!/system/bin/sh
# VirtualAP iw wrapper for Samsung Galaxy M32 5G (Dimensity 720 / MT6853)
# Keeps MediaTek Wi-Fi chip awake and ensures ap0 creates cleanly without turning on Wi-Fi or Hotspot

REAL_IW="/data/local/virtualap/bin/iw.real"
[ ! -x "$REAL_IW" ] && REAL_IW="/system/bin/iw"

# Native Mode: If user opted to disable module modifications completely, execute real iw directly
if [ -f "/data/local/virtualap/native_mode.flag" ]; then
    exec "$REAL_IW" "$@"
fi

# Always ensure MTK Wi-Fi driver is awake
if [ -e /dev/wmtWifi ]; then
    echo 1 > /dev/wmtWifi 2>/dev/null
fi

# Ensure ap0 exists: On MediaTek MT6853, driver creates hardware AP vif 'swlan0'.
# We seamlessly rename swlan0 to ap0 if ap0 is not yet present.
ensure_ap0() {
    if [ -d "/sys/class/net/ap0" ]; then
        return 0
    fi
    if [ -d "/sys/class/net/swlan0" ]; then
        ip link set swlan0 down 2>/dev/null
        ip link set swlan0 name ap0 2>/dev/null
        [ -d "/sys/class/net/ap0" ] && return 0
    fi
    # If neither exists, give driver a kick
    if [ -e /dev/wmtWifi ]; then
        echo 1 > /dev/wmtWifi 2>/dev/null
        sleep 0.2
        if [ -d "/sys/class/net/swlan0" ]; then
            ip link set swlan0 down 2>/dev/null
            ip link set swlan0 name ap0 2>/dev/null
            [ -d "/sys/class/net/ap0" ] && return 0
        fi
    fi
    return 1
}

case "$*" in
    *"interface add"*"ap0"*|*"interface add ap0"*)
        ensure_ap0 && exit 0
        # If not present, try real iw
        "$REAL_IW" "$@" 2>/dev/null
        rc=$?
        ensure_ap0 && exit 0
        exit $rc
        ;;
    *"dev ap0 del"*|*"dev swlan0 del"*)
        # Do not delete the hardware vif from kernel; bring down and flush so it is ready for next use
        ip link set ap0 down 2>/dev/null
        ip addr flush dev ap0 2>/dev/null
        exit 0
        ;;
    *"dev ap0 info"*)
        ensure_ap0
        if [ -d "/sys/class/net/ap0" ]; then
            "$REAL_IW" "$@" 2>/dev/null && exit 0
            echo "Interface ap0"
            echo "    type AP"
            echo "    wiphy 0"
            exit 0
        fi
        exec "$REAL_IW" "$@"
        ;;
    *)
        exec "$REAL_IW" "$@"
        ;;
esac
